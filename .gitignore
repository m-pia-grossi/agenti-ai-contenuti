# Sistema
.DS_Store
Thumbs.db

# Memoria curata: includere solo i file esplicitamente approvati (T4)
/archivio/*
!/archivio/voce.md
!/archivio/post-indice.md
!/archivio/post-testi.md
/dati/*
!/dati/performance-linkedin.md

# Bozze di lavoro locali; conservare soltanto la struttura della cartella
/bozze/*
!/bozze/.gitkeep

# Bozze e risultati generati provando la demo originale
mastella/esempio-mastella/bozze/*
!mastella/esempio-mastella/bozze/.gitkeep
mastella/esempio-mastella/dati/gruppi-di-domande.md

# Export grezzi e impostazioni locali
*.csv
*.zip
.env
.env.*
*.local.*
mastella/.claude-mastella/settings.local.json
